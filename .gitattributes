# Normalize line endings in text files to LF in the repository.
* text=auto eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.onnx binary
*.sqlite binary

# Generated lock files are collapsed in diffs on GitHub.
Cargo.lock linguist-generated=true
**/pnpm-lock.yaml linguist-generated=true
