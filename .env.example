# OpenAudioHub image version. Pin to a release (e.g. `0.5.3`) for reproducible deploys.
OPENAUDIOHUB_VERSION=latest

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/openaudiohub

# Postgres password for the bundled `db` service. Unset defaults to `postgres`
# so existing volumes still start (Postgres applies this only on first init).
# The one-line installer writes a random value. Changing this env var alone
# does not change an already-initialized database. To rotate in place:
#   openssl rand -hex 24
#   docker compose exec db psql -U postgres -c "ALTER USER postgres WITH PASSWORD '<value>'"
#   set POSTGRES_PASSWORD=<value> in this file
#   docker compose up -d --force-recreate app
# Recreating the db volume is not required and would wipe data.
# POSTGRES_PASSWORD=

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-hex-32
# Optional. Use a separate 32+ character secret if you want to rotate
# BETTER_AUTH_SECRET without invalidating API token hashes.
# API_TOKEN_HASH_SECRET=
APP_URL=http://localhost:3000

# Disable email/password registration. Default `false`.
# DISABLE_REGISTRATION=false

# Disable the footer "update available" check against api.github.com.
# DISABLE_UPDATE_CHECK=false

# Require public HTTPS webhook targets with DNS pinning. Defaults to false.
# Set false to allow Docker-network URLs like http://n8n:5678/webhook.
# WEBHOOKS_REQUIRE_PUBLIC_TARGETS=false

# Trust X-Forwarded-For for /api/v1/* rate limiting. Only enable behind a
# trusted reverse proxy that strips client-supplied forwarding headers.
# RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Encryption (for API keys, tokens, S3 credentials)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# Optional outbound proxy for Plaud API calls. Useful when the host's egress
# IP can't reach Plaud directly (geo-restriction, ISP blocking, datacenter
# IP filtering). Set this to a Webshare API key and Plaud-bound requests
# (api*.plaud.ai, resource.plaud.ai) are routed through a random valid proxy
# from your Webshare account, with automatic rotation on 403/407. Unset
# (default) sends all calls direct. No effect on non-Plaud outbound traffic.
# WEBSHARE_API_KEY=

# Proxy scope. `all` (default) proxies api*.plaud.ai and resource.plaud.ai
# audio downloads. `api-only` skips audio downloads to save proxy bandwidth.
# Inert when WEBSHARE_API_KEY is unset.
# PLAUD_PROXY_SCOPE=all

# Per-user rate limit on POST /api/plaud/sync (requests per minute).
# Default 10. Range 1..600.
# PLAUD_SYNC_RATE_LIMIT_PER_MINUTE=10

# Server-side background sync worker: polls Plaud and processes new
# recordings on its own schedule, independent of any open browser tab -- so
# unattended `docker compose up` deployments keep syncing.
#
# Master switch. Default true. Set false to opt out entirely (e.g. to sync
# only when the app is open, or to drive syncing yourself via cron hitting
# POST /api/plaud/sync).
# BACKGROUND_SYNC_ENABLED=true
#
# Tick interval in milliseconds. Default 300000 (5 min). Range
# 60000..3600000. Note: the worker also skips any user synced in the last 4
# minutes regardless of this value, so setting it below 4 min has no effect
# beyond extra database queries.
# BACKGROUND_SYNC_INTERVAL_MS=300000

# OpenAI-style transcription limits. WHISPER_MAX_BYTES must not exceed the
# provider's 25 MiB hard limit. Audio above it is re-encoded to mono Opus,
# starting at the configured bitrate and adapting
# downward when needed to stay below the provider's 25 MiB hard limit.
# WHISPER_REQUEST_TIMEOUT_MS applies to Whisper-style
# /v1/audio/transcriptions and chat-style (OpenRouter) transcription.
# Default 3600000 (60 min). The OpenAI Node SDK default is 10 min, which
# aborts long recordings even when the provider is still working.
# WHISPER_MAX_BYTES=25165824
# WHISPER_COMPRESS_BITRATE_KBPS=12
# WHISPER_REQUEST_TIMEOUT_MS=3600000

# Long-audio preprocessing. On by default (D-029). When enabled, newly
# requested server-side transcriptions for configured providers use the private
# Silero VAD + Smart Chunking service; browser transcription is unchanged.
# Generate one shared service secret and set it here. Compose passes it to both
# services. AI provider keys remain in Core and are not sent to the pipeline.
AUDIO_PIPELINE_ENABLED=true
# AUDIO_PIPELINE_BASE_URL=http://audio-pipeline:8100
AUDIO_PIPELINE_TOKEN=replace-with-a-long-random-secret

# Per-user hourly cap on auto-generated summaries. Only the post-
# transcription auto path is throttled; the manual "Generate summary"
# button stays unthrottled. When the bucket is exhausted, the
# transcript still saves and a `summary.failed` webhook event fires
# with a "rate limit" error. Default 60. Range 1..600.
# AUTO_SUMMARY_RATE_LIMIT_PER_HOUR=60

# Storage Configuration
DEFAULT_STORAGE_TYPE=local

# Local storage path. The bundled docker-compose.yml mounts named volumes at
# /app/audio and /app/storage, and forwards LOCAL_STORAGE_PATH with default
# /app/audio. Leave this unset (or set to /app/audio) for Docker. For local
# dev outside Docker, use ./storage.
# LOCAL_STORAGE_PATH=/app/audio

# S3-compatible storage config (only needed if DEFAULT_STORAGE_TYPE=s3)
# S3_ENDPOINT=https://accountid.r2.cloudflarestorage.com
# S3_BUCKET=openaudiohub
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# SMTP Configuration (optional - for email notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@example.com

# Optional Reply-To applied to every outbound transactional email. Lets From:
# stay a no-reply sender while replies land in a monitored inbox. Unset means
# no Reply-To header is added.
# SMTP_REPLY_TO="OpenAudioHub Support <support@example.com>"
