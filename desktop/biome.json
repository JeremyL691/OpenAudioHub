{
    "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
    "root": false,
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "src/**/*.{ts,mts,json}",
            "test/**/*.{ts,mts,json}",
            "scripts/**/*.{mjs,json}",
            "*.{ts,mts,mjs,json}",
            "!build",
            "!dist",
            "!.cache",
            "!node_modules"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
