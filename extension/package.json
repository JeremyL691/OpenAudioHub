{
    "name": "openaudiohub-extension",
    "version": "1.2.5",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.11.2",
    "scripts": {
        "build": "node build.mjs",
        "build:test": "node build.mjs --test",
        "zip": "node build.mjs --zip",
        "typecheck": "tsc --noEmit",
        "test": "node build.mjs && vitest run",
        "e2e": "node build.mjs --test && playwright test -c tests/e2e/playwright.config.ts"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@types/chrome": "0.3.5",
        "@types/node": "26.6.5",
        "esbuild": "0.28.2",
        "typescript": "7.0.2",
        "vitest": "5.0.5"
    }
}
