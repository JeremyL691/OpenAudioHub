exports[`email templates > email change confirmation 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="preload" as="image" href="https://oah.test/brand/email-logo.png"/><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light"/><meta name="supported-color-schemes" content="light"/></head><body style="background-color:#f3f7fc;margin:0"><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Confirm the email change on your OpenAudioHub account.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f3f7fc;font-family:-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;padding:0;margin:0;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;background-color:#f9fcff;margin:0 auto;padding:0;width:100%"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 20px;text-align:center;border-top:3px solid #286ef9;border-bottom:1px solid #d8dfe9"><tbody><tr><td><div style="text-align:center"><img alt="OpenAudioHub" height="32" src="https://oah.test/brand/email-logo.png" style="display:inline-block;outline:none;border:none;text-decoration:none;width:32px;height:32px;margin:0 auto;vertical-align:middle" width="32"/></div></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:32px 20px;background-color:#f9fcff"><tbody><tr><td><h1 style="color:#060a12;font-size:24px;font-weight:600;margin:0 0 12px 0;line-height:1.3;letter-spacing:-0.01em">Confirm email change.</h1><p style="font-size:16px;line-height:1.6;color:#060a12;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">A change request was made to update the email on your OpenAudioHub account to <strong>new@example.com</strong>. Click below to confirm. The link expires in 24 hours.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:32px 0;text-align:center"><tbody><tr><td><a href="https://oah.test/confirm-email?token=abc123" style="line-height:1.5;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#101723;color:#fafafa;font-size:16px;font-weight:500;padding:14px 32px;border-radius:6px;border:none;min-width:200px;padding-top:14px;padding-right:32px;padding-bottom:14px;padding-left:32px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:21" hidden>&#8202;&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:10.5px">Confirm new email</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:16px;line-height:1.6;color:#060a12;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">If you did not request this change, ignore this message and consider rotating your password.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 20px;border-top:1px solid #d8dfe9;background-color:#f3f7fc;text-align:center"><tbody><tr><td><p style="font-size:13px;line-height:1.5;color:#636974;margin:0 0 8px 0;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">OpenAudioHub · Self-hosted AI transcription and summaries for Plaud recordings.</p><p style="font-size:13px;line-height:1.5;color:#636974;margin:0 0 8px 0;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://github.com/JeremyL691/OpenAudioHub" style="color:#101723;text-decoration-line:none;text-decoration:underline" target="_blank">Source code</a> · OpenAudioHub contributors · Based on Riffado (AGPL-3.0)</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;

exports[`email templates > export ready 1`] = `"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1.0"/><link rel="preload" as="image" href="https://oah.test/brand/email-logo.png"/><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light"/><meta name="supported-color-schemes" content="light"/></head><body style="background-color:#f3f7fc;margin:0"><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Your OpenAudioHub data export is ready to download.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="background-color:#f3f7fc;font-family:-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;padding:0;margin:0;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;background-color:#f9fcff;margin:0 auto;padding:0;width:100%"><tbody><tr style="width:100%"><td><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 20px;text-align:center;border-top:3px solid #286ef9;border-bottom:1px solid #d8dfe9"><tbody><tr><td><div style="text-align:center"><img alt="OpenAudioHub" height="32" src="https://oah.test/brand/email-logo.png" style="display:inline-block;outline:none;border:none;text-decoration:none;width:32px;height:32px;margin:0 auto;vertical-align:middle" width="32"/></div></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:32px 20px;background-color:#f9fcff"><tbody><tr><td><h1 style="color:#060a12;font-size:24px;font-weight:600;margin:0 0 12px 0;line-height:1.3;letter-spacing:-0.01em">Your export is ready</h1><p style="font-size:16px;line-height:1.6;color:#060a12;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">We finished building your full data archive: every recording&#x27;s audio, transcript, and AI summary, zipped up and ready to download.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:32px 0;text-align:center"><tbody><tr><td><a href="https://oah.test/settings/export" style="line-height:1.5;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;background-color:#101723;color:#fafafa;font-size:16px;font-weight:500;padding:14px 32px;border-radius:6px;border:none;min-width:200px;padding-top:14px;padding-right:32px;padding-bottom:14px;padding-left:32px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:21" hidden>&#8202;&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:10.5px">Download export</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p style="font-size:16px;line-height:1.6;color:#060a12;margin:0 0 16px 0;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">The download link stays active for 7 days.</p></td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="padding:24px 20px;border-top:1px solid #d8dfe9;background-color:#f3f7fc;text-align:center"><tbody><tr><td><p style="font-size:13px;line-height:1.5;color:#636974;margin:0 0 8px 0;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://oah.test/settings/export" style="color:#101723;text-decoration-line:none;text-decoration:underline" target="_blank">Download export</a></p><p style="font-size:13px;line-height:1.5;color:#636974;margin:0 0 8px 0;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">OpenAudioHub · Self-hosted AI transcription and summaries for Plaud recordings.</p><p style="font-size:13px;line-height:1.5;color:#636974;margin:0 0 8px 0;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0"><a href="https://github.com/JeremyL691/OpenAudioHub" style="color:#101723;text-decoration-line:none;text-decoration:underline" target="_blank">Source code</a> · OpenAudioHub contributors · Based on Riffado (AGPL-3.0)</p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></body></html>"`;

